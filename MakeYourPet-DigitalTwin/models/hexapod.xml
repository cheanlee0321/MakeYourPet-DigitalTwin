<mujoco model="makeyourpet_hexapod_high_fidelity">
  <compiler angle="degree" coordinate="local"/>
  <option gravity="0 0 -9.81" timestep="0.002" integrator="implicitfast"/>

  <visual>
    <scale framelength="0.15" framewidth="0.008"/>
  </visual>

  <!-- 視覺與網格資源載入 -->
  <asset>
    <!-- 3D 列印 STL 網格 (單位 mm -> m 縮放 0.001) -->
    <mesh name="mesh_frame" file="../../MakeYourPet-hexapod/hexapod-main/STL/frame.stl" scale="0.001 0.001 0.001"/>
    <mesh name="mesh_top_cover" file="../../MakeYourPet-hexapod/hexapod-main/STL/top-cover.stl" scale="0.001 0.001 0.001"/>
    <mesh name="mesh_left_coxa" file="../../MakeYourPet-hexapod/hexapod-main/STL/left-coxa.stl" scale="0.001 0.001 0.001"/>
    <mesh name="mesh_left_femur" file="../../MakeYourPet-hexapod/hexapod-main/STL/left-femur.stl" scale="0.001 0.001 0.001"/>
    <mesh name="mesh_left_tibia" file="../../MakeYourPet-hexapod/hexapod-main/STL/left-tibia.stl" scale="0.001 0.001 0.001"/>
    <mesh name="mesh_right_coxa" file="../../MakeYourPet-hexapod/hexapod-main/STL/right-coxa.stl" scale="0.001 0.001 0.001"/>
    <mesh name="mesh_right_femur" file="../../MakeYourPet-hexapod/hexapod-main/STL/right-femur.stl" scale="0.001 0.001 0.001"/>
    <mesh name="mesh_right_tibia" file="../../MakeYourPet-hexapod/hexapod-main/STL/right-tibia.stl" scale="0.001 0.001 0.001"/>
    <mesh name="mesh_right_shield" file="../../MakeYourPet-hexapod/hexapod-main/STL/shield.stl" scale="0.001 0.001 0.001"/>
    <mesh name="mesh_left_shield"  file="../../MakeYourPet-hexapod/hexapod-main/STL/shield.stl" scale="0.001 -0.001 0.001"/>
    <mesh name="mesh_tip" file="../../MakeYourPet-hexapod/hexapod-main/STL/tip.stl" scale="0.001 0.001 0.001"/>

    <!-- 外觀材質配色 -->
    <material name="mat_frame" rgba="0.18 0.20 0.24 1.0" specular="0.5" shininess="0.3"/>
    <material name="mat_armor" rgba="0.95 0.70 0.12 1.0" specular="0.8" shininess="0.5"/>
    <material name="mat_leg_dark" rgba="0.15 0.15 0.16 1.0" specular="0.4" shininess="0.2"/>
    <material name="mat_phone" rgba="0.08 0.08 0.10 1.0" specular="0.9" shininess="0.8"/>
    <material name="mat_rubber" rgba="0.85 0.15 0.15 1.0"/>

    <!-- 地面木紋貼圖與材質 -->
    <texture name="tex_wood" type="2d" file="wood.png"/>
    <material name="mat_wood" texture="tex_wood" texrepeat="14 14" reflectance="0.15" specular="0.3"/>

    <!-- 地形高低起伏高度場資源 (160x160 高精網格，水平跨距 10x10 米，最大高差上限 8.0cm) -->
    <hfield name="terrain" nrow="160" ncol="160" size="5 5 0.08 0.1"/>
  </asset>

  <worldbody>
    <!-- 1. 原版中央專屬強效聚光燈 (Spotlight，照射機器人與起點圓台，產生清晰足端陰影) -->
    <light name="spotlight_center" diffuse="0.9 0.9 0.9" specular="0.3 0.3 0.3" pos="0 0 2.5" dir="0 0 -1"/>

    <!-- 2. 四大區域獨立中心頂光 (東北、西北、西南、東南) -->
    <light name="light_ne" diffuse="0.75 0.75 0.75" specular="0.2 0.2 0.2" pos=" 2.5  2.5 3.0" dir="0 0 -1"/>
    <light name="light_nw" diffuse="0.75 0.75 0.75" specular="0.2 0.2 0.2" pos="-2.5  2.5 3.0" dir="0 0 -1"/>
    <light name="light_sw" diffuse="0.75 0.75 0.75" specular="0.2 0.2 0.2" pos="-2.5 -2.5 3.0" dir="0 0 -1"/>
    <light name="light_se" diffuse="0.75 0.75 0.75" specular="0.2 0.2 0.2" pos=" 2.5 -2.5 3.0" dir="0 0 -1"/>
    <geom name="ground" type="hfield" hfield="terrain" material="mat_wood" friction="1.2 0.05 0.001" solref="0.002 1" solimp="0.95 0.99 0.0005 0.5 2"/>

    <!-- 六足機體軀幹 (自由關節 freejoint，標稱站姿高度 0.082m) -->
    <body name="trunk" pos="0 0 0.082">
      <freejoint name="root"/>
      <!-- 核心修正：機身主框架 (frame) 與頂蓋 (top-cover) 沿 Z 軸旋轉 90 度，使長軸與六足朝向對齊！ -->
      <geom name="vis_frame" type="mesh" mesh="mesh_frame" pos="0 0 -0.008" euler="0 0 90" material="mat_frame" contype="0" conaffinity="0" group="1"/>
      <geom name="vis_cover" type="mesh" mesh="mesh_top_cover" pos="0 0 0.008" euler="0 0 90" material="mat_armor" contype="0" conaffinity="0" group="1"/>
      <!-- 物理碰撞層：內建極簡膠囊/盒體 (Collision Geometry, group=3) -->
      <geom name="col_frame" type="box" size="0.095 0.065 0.012" rgba="0 0 0 0" mass="0.50" group="3"/>
      <geom name="col_phone" type="box" pos="0 0 0.018" size="0.075 0.038 0.006" rgba="0 0 0 0" mass="0.18" group="3"/>
      <geom name="col_batt"  type="box" pos="0 0 -0.018" size="0.055 0.028 0.010" rgba="0 0 0 0" mass="0.25" group="3"/>
