              <geom name="tip_L1" type="sphere" pos="0.0477 -0.0025 -0.1059" size="0.0048" mass="0.01" material="mat_rubber" friction="1.2 0.05 0.001" solref="0.002 1" solimp="0.95 0.99 0.0005 0.5 2" group="3"/>
