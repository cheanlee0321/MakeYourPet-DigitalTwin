      <geom name="vis_axis_z_tip" type="sphere" pos="0 0 0.12" size="0.007" rgba="0.15 0.45 1.0 1.0" contype="0" conaffinity="0" group="1"/>

      <!-- ========== 左前足 (L1) ========== -->
