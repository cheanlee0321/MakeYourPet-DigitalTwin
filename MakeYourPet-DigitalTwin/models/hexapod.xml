          <geom name="vis_coxa_L1" type="mesh" mesh="mesh_left_coxa" material="mat_leg_dark" contype="0" conaffinity="0" group="1"/>
          <geom name="col_coxa_L1" type="capsule" fromto="0 0 0 0.043 0 0" size="0.012" mass="0.06" rgba="0 0 0 0" group="3"/>
          <!-- 2. Femur 大腿升降節 (Pitch): 80mm (Z 字形斜挑頂端 +46mm) -->
          <body name="femur_L1" pos="0.043 0 0">
