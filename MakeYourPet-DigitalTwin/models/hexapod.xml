            <geom name="col_femur_L1" type="capsule" fromto="0 0 0 0.065 0 0.046" size="0.011" mass="0.08" rgba="0 0 0 0" group="3"/>
            <!-- 3. Tibia 小腿屈伸節 (Pitch): 134mm -->
