      <!-- +X (紅 / 前方 Front): 長度 100mm -->
      <geom name="vis_axis_x" type="cylinder" fromto="0 0 0.04 0.10 0 0.04" size="0.003" rgba="1.0 0.15 0.15 0.95" contype="0" conaffinity="0" group="1"/>
      <geom name="vis_axis_x_tip" type="sphere" pos="0.10 0 0.04" size="0.007" rgba="1.0 0.15 0.15 1.0" contype="0" conaffinity="0" group="1"/>
      <!-- +Y (綠 / 左側 Left): 長度 100mm -->
      <geom name="vis_axis_y" type="cylinder" fromto="0 0 0.04 0 0.10 0.04" size="0.003" rgba="0.15 0.95 0.15 0.95" contype="0" conaffinity="0" group="1"/>
      <geom name="vis_axis_y_tip" type="sphere" pos="0 0.10 0.04" size="0.007" rgba="0.15 0.95 0.15 1.0" contype="0" conaffinity="0" group="1"/>
      <!-- +Z (藍 / 上方 Up): 長度 80mm -->
